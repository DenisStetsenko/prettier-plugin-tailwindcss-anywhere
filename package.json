{
  "name": "@denstetsenko/prettier-plugin-tailwindcss-anywhere",
  "version": "0.1.7",
  "description": "A Prettier plugin for sorting TailwindCSS classes in any HTML-like language, like Twig etc.",
  "keywords": ["prettier", "tailwindcss", "formatter", "html", "twig"],
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">= 20.9 < 25"
  },
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "files": ["dist", "src"],
  "dependencies": {
    "tslib": "~2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "~24",
    "@vitest/coverage-v8": "~4.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8",
    "rimraf": "~6.1",
    "ts-api-utils": "~1.3",
    "typescript": "~5.5",
    "vitest": "~4.1"
  },
  "peerDependencies": {
    "prettier": "^3.7",
    "prettier-plugin-tailwindcss": "^0.8"
  },
  "scripts": {
    "prepare": "husky",
    "start": "node dist/index.js",
    "clean": "rimraf coverage dist tmp",
    "prebuild": "biome lint",
    "build": "tsc -d -p tsconfig.json",
    "build:watch": "tsc -w -d -p tsconfig.json",
    "build:release": "npm run clean && tsc -d -p tsconfig.release.json",
    "prepublishOnly": "npm run build:release",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "vitest run --dir __tests__ unit",
    "test:coverage": "vitest run --dir __tests__ unit --coverage.enabled --coverage.include=src",
    "test:watch": "vitest --dir __tests__ unit"
  },
  "author": "Takashi Kanemoto <ttskch@gmail.com>",
  "homepage": "https://github.com/DenisStetsenko/prettier-plugin-tailwindcss-anywhere",
  "bugs": "https://github.com/DenisStetsenko/prettier-plugin-tailwindcss-anywhere/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenisStetsenko/prettier-plugin-tailwindcss-anywhere.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
